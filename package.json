{
  "name": "calorie-tracker",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package && cd node_modules/react-native-litert-lm && npx nitrogen@0.35.4",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "web": "expo start --web"
  },
  "dependencies": {
    "@kesha-antonov/react-native-background-downloader": "^4.5.4",
    "@op-engineering/op-sqlite": "^15.2.12",
    "@react-native-community/slider": "^5.2.0",
    "@react-navigation/bottom-tabs": "~7.15.10",
    "@react-navigation/native": "~7.2.2",
    "drizzle-orm": "^0.45.2",
    "expo": "~55.0.17",
    "expo-dev-client": "~55.0.28",
    "expo-document-picker": "^55.0.13",
    "expo-file-system": "^55.0.17",
    "expo-font": "^55.0.6",
    "expo-router": "^55.0.13",
    "expo-sharing": "^55.0.18",
    "expo-splash-screen": "^55.0.19",
    "react": "~19.2.5",
    "react-native": "^0.83.6",
    "react-native-chart-kit": "^6.12.1",
    "react-native-device-info": "^15.0.2",
    "react-native-health-connect": "^3.5.0",
    "react-native-litert-lm": "0.3.7",
    "react-native-mmkv": "^4.3.1",
    "react-native-paper": "^5.15.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-svg": "^15.15.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/react": "~19.2.14",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "better-sqlite3": "^12.9.0",
    "drizzle-kit": "^0.31.10",
    "esbuild-register": "^3.6.0",
    "expo-build-properties": "^55.0.13",
    "patch-package": "^8.0.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "private": true
}
