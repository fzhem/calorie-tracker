{
  "expo": {
    "name": "Calorie Tracker",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/ic_launcher-playstore.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/ic_launcher-playstore.png",
      "resizeMode": "contain",
      "backgroundColor": "#f2433b"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.fzhem.calorietracker",
      "displayName": "Calorie Tracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/ic_launcher-playstore.png",
        "backgroundColor": "#f2433b"
      },
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_HEALTH_DATA_HISTORY"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/ic_launcher-playstore.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withHealthConnectPermissionDelegate"
    ]
  }
}
