{
  "name": "calorie-tracker",
  "main": "src/app/index.tsx",
  "scripts": {
    "start": "expo start --dev-client",
    "postinstall": "patch-package && cd node_modules/react-native-litert-lm && npx nitrogen@0.35.3",
    "android": "expo run:android",
    "android:sync": "npm run android:icons && npm run android:gradle && npm run android:manifest",
    "android:icons": "node scripts/sync-android-icons.js",
    "android:gradle": "node scripts/sync-android-build-gradle.js",
    "android:manifest": "node scripts/sync-android-manifest.js",
    "prebuild": "expo prebuild --platform android && npm run android:sync",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node -r esbuild-register ./src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "web": "expo start --web"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^15.2.12",
    "@react-native-community/slider": "^5.2.0",
    "@react-navigation/bottom-tabs": "~7.15.10",
    "@react-navigation/native": "~7.2.2",
    "drizzle-orm": "^0.45.2",
    "expo": "~55.0.17",
    "expo-dev-client": "~55.0.28",
    "expo-document-picker": "^55.0.13",
    "expo-file-system": "^55.0.17",
    "expo-font": "^55.0.6",
    "expo-sharing": "^55.0.18",
    "expo-splash-screen": "^55.0.19",
    "react": "~19.2.5",
    "react-native": "^0.83.6",
    "react-native-chart-kit": "^6.12.1",
    "react-native-device-info": "^15.0.2",
    "react-native-health-connect": "^3.5.0",
    "react-native-litert-lm": "0.3.4",
    "react-native-mmkv": "^4.3.1",
    "react-native-paper": "^5.15.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-svg": "^15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "better-sqlite3": "^12.9.0",
    "drizzle-kit": "^0.31.10",
    "esbuild-register": "^3.6.0",
    "expo-build-properties": "^55.0.13",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
