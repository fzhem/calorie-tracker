{
  "expo": {
    "name": "Calorie Tracker",
    "version": "0.7.0",
    "icon": "./assets/ic_launcher-playstore.png",
    "scheme": "calorietracker",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.zane.calorietracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/ic_launcher-playstore.png",
        "backgroundColor": "#f2433b"
      },
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_HEALTH_DATA_HISTORY",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/ic_launcher-playstore.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withAndroidIcons",
      "./plugins/withAndroidManifestExtras",
      "./plugins/withAndroidBuildGradle",
      "./plugins/withLiteRTProguard",
      "./plugins/withHealthConnectPermissionDelegate",
      "@kesha-antonov/react-native-background-downloader"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a9eee0dc-f2c0-4e28-bc90-84e9472d0f67"
      }
    },
    "owner": "expo-faiz"
  }
}
